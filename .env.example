# Existing keys are read directly; keep real credentials out of Git.
GEMINI_API_KEY=
TAVILY_API_KEY=
# auto prefers a currently verified free-tier model available to your key.
GEMINI_MODEL=auto
GEMINI_THINKING_LEVEL=high
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=
LEAGUE_CACHE_SECONDS=300
STATS_CACHE_SECONDS=21600
CACHE_PATH=.cache/fantasy.sqlite3
DYNASTY_MAX_AGE_DAYS=30
